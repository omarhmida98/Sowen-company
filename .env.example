# ---------- Database ----------
DATABASE_URL="postgresql://sowen:sowen_dev_password@localhost:5432/sowen?schema=public"

# ---------- API ----------
API_PORT=4000
WEB_URL="http://localhost:3000"
JWT_ACCESS_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_VALUE"
JWT_REFRESH_SECRET="CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_VALUE"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Création de compte publique (/register). Toujours ouverte tant qu'aucun compte n'existe ; "true" la laisse ouverte ensuite.
ALLOW_PUBLIC_REGISTRATION="false"

# ---------- AI (optional until enabled) ----------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# ---------- Email (optional until enabled) ----------
# Fournisseur d'emails : "gmail" (SMTP Gmail + mot de passe d'application) ou "resend".
EMAIL_PROVIDER=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
RESEND_API_KEY=""
RESEND_FROM="SOWEN <no-reply@example.com>"
# Jours sans réponse après l'envoi avant de relancer une observation « Envoyé » (3 par défaut, 0 pour désactiver).
SENT_REMINDER_AFTER_DAYS="3"
# Relances automatiques (scan horaire). Désactivé par défaut.
REMINDER_AUTOMATION_ENABLED="false"
# Relances automatiques : nombre maximal de relances envoyées par le scan pour un même mail, et plage d'envoi (jours ouvrés).
MAX_AUTOMATIC_REMINDERS="3"
REMINDER_TIMEZONE="Europe/Paris"
REMINDER_START_HOUR="8"
REMINDER_END_HOUR="18"
# Adresse publique de l'application (ex. https://app.votre-domaine.fr). Sans elle, les emails ne contiennent aucun lien.
PUBLIC_APP_URL=""
# Synthèse quotidienne interne (administrateurs et éditeurs).
DAILY_DIGEST_ENABLED="false"
# Fuseau horaire de la synthèse quotidienne (envoi à 08:00, du lundi au vendredi). Europe/Paris par défaut.
DAILY_DIGEST_TIMEZONE="Europe/Paris"

# ---------- Document storage ----------
# Stockage des documents : "local" (dossier back/uploads, développement) ou "s3" (stockage objet compatible S3 : OVH, Cloudflare R2, AWS...).
# Le choix est explicite : renseigner les variables S3_* ne suffit pas, il faut STORAGE_PROVIDER="s3".
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Comptes et accès
# Durée de validité des liens envoyés aux utilisateurs (invitation, réinitialisation du mot de passe), en heures.
INVITATION_TTL_HOURS="72"
PASSWORD_RESET_TTL_HOURS="24"
# Limitation des tentatives (connexion, changement de mot de passe, liens). Les compteurs sont enregistrés en base :
# ils survivent à un redémarrage et sont partagés entre plusieurs instances de l’API. Fenêtre en minutes, puis nombre
# d’échecs autorisés : même compte depuis la même adresse, même compte toutes adresses, même adresse.
AUTH_RATE_LIMIT_ENABLED="true"
AUTH_RATE_LIMIT_WINDOW_MINUTES="15"
AUTH_LOGIN_MAX_ATTEMPTS="5"
AUTH_ACCOUNT_MAX_ATTEMPTS="20"
AUTH_IP_MAX_ATTEMPTS="50"
# Nombre de proxys inverses devant l’API. En production derrière le proxy inverse (OVH, Nginx, Caddy…) mettre "1" :
# sans cela tous les visiteurs ont l’adresse du proxy et partagent le même compteur par adresse. Laisser vide en
# accès direct : l’en-tête X-Forwarded-For n’est alors pas pris en compte et ne peut pas être falsifié.
TRUST_PROXY=""
