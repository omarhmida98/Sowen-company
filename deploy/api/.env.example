# Secrets and settings of the API in production. Copy to deploy/api/.env (never committed), chmod 600, and fill in.
# DATABASE_URL, WEB_URL, PUBLIC_APP_URL, NODE_ENV, API_HOST, API_PORT, TRUST_PROXY and STORAGE_LOCAL_DIR are set by
# docker-compose.prod.yml: do not repeat them here.

# ---------- Secrets ----------
# Four different random values of at least 32 characters. The API refuses to start with an example, short or
# repeated value. Generate each one with:  openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
# Signs the company portal links. Keep a copy in a safe place: changing it invalidates every link already sent.
PORTAL_TOKEN_SECRET=""
# Leave empty: the reminder scan runs inside the API every hour. Only set it if an external scheduler must call
# POST /api/reminders/cron, which stays disabled while this is empty.
CRON_SECRET=""

JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ---------- Accounts ----------
# Public sign-up stays closed. The first administrator is created on the server (docs/DEPLOYMENT.md).
ALLOW_PUBLIC_REGISTRATION="false"
INVITATION_TTL_HOURS="72"
PASSWORD_RESET_TTL_HOURS="24"
AUTH_RATE_LIMIT_ENABLED="true"
AUTH_RATE_LIMIT_WINDOW_MINUTES="15"
AUTH_LOGIN_MAX_ATTEMPTS="5"
AUTH_ACCOUNT_MAX_ATTEMPTS="20"
AUTH_IP_MAX_ATTEMPTS="50"

# ---------- Company portal ----------
PORTAL_ACCESS_TTL_DAYS="90"
# Limits on what a company can send through its link.
PORTAL_UPLOADS_PER_HOUR="20"
PORTAL_MAX_FILES_PER_OBSERVATION="30"
PORTAL_MAX_TOTAL_MB="500"
PORTAL_RESPONSES_PER_HOUR="30"

# ---------- AI ----------
# A key created for this installation, not the one used in development.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# ---------- Email ----------
EMAIL_PROVIDER=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
RESEND_API_KEY=""
RESEND_FROM=""
SENT_REMINDER_AFTER_DAYS="3"
REMINDER_AUTOMATION_ENABLED="false"
MAX_AUTOMATIC_REMINDERS="3"
REMINDER_TIMEZONE="Europe/Paris"
REMINDER_START_HOUR="8"
REMINDER_END_HOUR="18"
DAILY_DIGEST_ENABLED="false"
DAILY_DIGEST_TIMEZONE="Europe/Paris"

# ---------- Documents ----------
# "local": files are kept in the Docker volume sowen_uploads. It MUST be backed up off the server (docs/BACKUP_RESTORE.md).
# "s3": S3-compatible object storage (OVH Object Storage, …).
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
