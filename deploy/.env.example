# Settings of the production Docker stack. Copy to deploy/.env (never committed) and fill in.

# The public https address of SOWEN, without a trailing slash.
PUBLIC_APP_URL="https://app.example.com"

# Database of this installation. The password must be new: never the development one of the repository.
# Letters and digits only (it is placed in a URL), for example:  openssl rand -hex 32
POSTGRES_USER="sowen"
POSTGRES_DB="sowen"
POSTGRES_PASSWORD=""
